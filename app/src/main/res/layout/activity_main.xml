<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.momanufaktur.mocam.CameraOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <!-- Teleprompter: nur sichtbar, wird nicht aufgezeichnet -->
    <LinearLayout
        android:id="@+id/prompterBox"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:layout_marginStart="8dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/prompter_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <com.momanufaktur.mocam.TeleprompterView
            android:id="@+id/prompterView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView android:id="@+id/btnPrompterPlay" style="@style/TopChip" android:text="▶" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐢"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/prompterSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="🐇"
                android:textSize="16sp" />

            <TextView android:id="@+id/btnPrompterSmaller" style="@style/TopChip" android:text="A−" />
            <TextView android:id="@+id/btnPrompterBigger" style="@style/TopChip" android:text="A+" />
            <TextView android:id="@+id/btnPrompterEdit" style="@style/TopChip" android:text="✎" />
            <TextView android:id="@+id/btnPrompterClose" style="@style/TopChip" android:layout_marginEnd="0dp" android:text="✕" />
        </LinearLayout>
    </LinearLayout>

    <!-- Weißer Blitz beim Auslösen -->
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white" />

    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#000000"
        android:shadowRadius="12"
        android:textColor="#FFFFFF"
        android:textSize="120sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Obere Leiste -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView android:id="@+id/btnSettings" style="@style/TopChip" />
                <TextView android:id="@+id/btnFlash" style="@style/TopChip" />
                <TextView android:id="@+id/btnFormat" style="@style/TopChip" />
                <TextView android:id="@+id/btnTimer" style="@style/TopChip" />
                <TextView android:id="@+id/btnLimit" style="@style/TopChip" />
                <TextView android:id="@+id/btnLower" style="@style/TopChip" />
                <TextView android:id="@+id/btnGrid" style="@style/TopChip" />
                <TextView android:id="@+id/btnQuality" style="@style/TopChip" />
                <TextView android:id="@+id/btnAudio" style="@style/TopChip" />
                <TextView android:id="@+id/btnExtension" style="@style/TopChip" />
                <TextView android:id="@+id/btnLogo" style="@style/TopChip" />
                <TextView android:id="@+id/btnPrompter" style="@style/TopChip" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/recIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/chip_bg"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="● 00:00"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- #8 Tonpegel während der Aufnahme -->
        <ProgressBar
            android:id="@+id/audioLevel"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="#4CAF50"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Untere Steuerung -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#88000000"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="14dp">

        <!-- #3 Teilen nach der Aufnahme -->
        <HorizontalScrollView
            android:id="@+id/shareBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/shareButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/exposureRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/exposureBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/exposureValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.0 EV"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/zoomChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <SeekBar
                android:id="@+id/zoomBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000" />

            <TextView
                android:id="@+id/zoomText"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filterBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="FOTO"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:padding="8dp"
                android:text="VIDEO"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <ImageView
                android:id="@+id/galleryThumb"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/thumb_bg"
                android:clipToOutline="true"
                android:contentDescription="Galerie"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/btnPause"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/round_btn"
                android:gravity="center"
                android:text="⏸"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:visibility="gone" />

            <View
                android:id="@+id/shutter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_photo"
                android:contentDescription="Auslöser" />

            <TextView
                android:id="@+id/btnSwitch"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/round_btn"
                android:contentDescription="Kamera wechseln"
                android:gravity="center"
                android:text="⟲"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Logo-Panel -->
    <LinearLayout
        android:id="@+id/logoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6111111"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/logoPanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logo platzieren"
            android:textColor="#FFD54F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/logoTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Im Bild mit einem Finger verschieben, mit zwei Fingern skalieren. Was du siehst, wird genau so aufgenommen."
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/logoLibrary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Antippen = auswählen · lange drücken = löschen"
            android:textColor="#88FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/logoFolderLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📁 Ordner: MoCam"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView android:id="@+id/btnLogoFolder" style="@style/TopChip" android:layout_marginEnd="0dp" android:text="Ordner wählen" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Neues Logo" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/logoSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Logo einblenden"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deckkraft"
                android:textColor="#FFFFFF" />

            <SeekBar
                android:id="@+id/logoAlphaBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/logoPhotosSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Logo auch auf Fotos"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/dragFixLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fingerrichtung: 0°"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView android:id="@+id/btnDragRotate" style="@style/TopChip" android:text="↻ 90°" />
            <TextView android:id="@+id/btnDragMirror" style="@style/TopChip" android:layout_marginEnd="0dp" android:text="⇋ Spiegeln" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoReset"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zurücksetzen" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoRotate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Drehen ↻" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Fertig" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogoCopyAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Dieses Register für alle übernehmen" />
    </LinearLayout>
    <!-- Grundeinstellungen -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6111111"
        android:fillViewport="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>
</FrameLayout>
